NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# === 장소 데이터 수집 API (선택) ===

# OpenStreetMap — 무료, 키 불필요
# https://overpass-api.de/api/interpreter

# Foursquare Places API — 무료 500회/일, 가입만 하면 됨
# https://location.foursquare.com/developer/
# NEXT_PUBLIC_FSQ_API_KEY=fsq_xxxxx

# Yelp Fusion API — 무료 500회/일, 가입만 하면 됨
# https://www.yelp.com/developers/v3/manage_app
# NEXT_PUBLIC_YELP_API_KEY=xxxxx

# Google Places API (New) — $200/월 무료, but 신용카드 등록 필수
# https://console.cloud.google.com/
# NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=xxxxx
