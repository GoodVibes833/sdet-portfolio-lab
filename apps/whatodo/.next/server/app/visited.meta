{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/visited/layout,_N_T_/visited/page,_N_T_/visited"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/visited/__PAGE__",
    "/visited",
    "/_index",
    "/_head"
  ]
}