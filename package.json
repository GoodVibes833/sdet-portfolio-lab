{
  "name": "sdet-portfolio-lab",
  "version": "1.0.0",
  "private": true,
  "description": "SDET portfolio monorepo: 캐나다가자 앱 + API/E2E/성능 테스트",
  "workspaces": [
    "apps/whatodo",
    "apps/target-server",
    "apps/aws-profiling-server",
    "tests/api"
  ],
  "scripts": {
    "dev:app": "npm run dev --workspace=apps/whatodo",
    "build:app": "npm run build --workspace=apps/whatodo",
    "start": "npm run start --workspace=apps/target-server",
    "dev:server": "npm run dev --workspace=apps/target-server",
    "test:api": "npm run test --workspace=tests/api",
    "test": "npm run test:api"
  }
}
